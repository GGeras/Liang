// Cloudflare Workers (static assets). Build: `npm run build`; deploy: `npx wrangler deploy`.
// Sem este arquivo o Wrangler deduz a pasta errada (`dist/`) e o site responde 404.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liang",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/liang/browser",
    // Rotas do app (/entrar, /admin/painel…) devolvem o index.html; o Angular resolve a rota
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
